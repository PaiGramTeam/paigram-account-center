PAI_INSTANCE=paigram-account-center
PAI_NETWORK_SUBNET=10.90.0.0/24
PAI_IMAGE_TAG=latest
PAI_HTTP_BIND=127.0.0.1
PAI_HTTP_PORT=18080
PAI_FRONTEND_BASE_URL=https://account.example.com
PAI_REQUIRE_EMAIL_VERIFICATION=false
PAI_POSTGRES_PASSWORD=replace-with-a-random-password
PAI_REDIS_PASSWORD=replace-with-a-random-password
PAI_PLATFORM_POSTGRES_PASSWORD=replace-with-a-random-password
PAI_PLATFORM_REDIS_PASSWORD=replace-with-a-random-password
PAI_SERVICE_TICKET_PRIVATE_KEY_PEM=replace-with-an-ed25519-private-key-pem
PAI_SERVICE_TICKET_PUBLIC_KEY_PEM=replace-with-the-matching-ed25519-public-key-pem
PAI_OAUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes
PAI_SECURITY_ENCRYPTION_KEY=replace-with-exactly-32-ascii-bytes
PAI_PLATFORM_CREDENTIAL_ENCRYPTION_KEY=replace-with-exactly-32-ascii-bytes
PAI_PLATFORM_GRPC_BIND=127.0.0.1
PAI_PLATFORM_GRPC_PORT=19000
PAI_MIHOMO_UPSTREAM_BASE_URL=https://mihomo-upstream.internal
PAI_MIHOMO_UPSTREAM_BEARER_TOKEN_FILE=
PAI_ADMIN_EMAIL=admin@paigram.local
PAI_ADMIN_PASSWORD=replace-with-a-strong-password
PAI_ADMIN_NAME=Administrator
