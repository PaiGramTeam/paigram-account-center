# Integration tests start shared PostgreSQL and Redis containers automatically.
PAI_TESTCONTAINERS_PROVIDER=podman
PAI_INTEGRATION_POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
PAI_INTEGRATION_REDIS_IMAGE=public.ecr.aws/docker/library/redis:7-alpine

# These values are only needed by the optional integration-doctor command.
PAI_TEST_DATABASE_DSN=postgres://platform_mihomo:password@127.0.0.1:5432/platform_mihomo_test?sslmode=disable
PAI_TEST_REDIS_ADDR=127.0.0.1:6379
PAI_TEST_REDIS_PASSWORD=
PAI_TEST_REDIS_DB=0
PAI_TEST_REDIS_PREFIX=itest
